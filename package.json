{
  "name": "linkgrab",
  "version": "1.1.0",
  "description": "Desktop download manager for YouTube, Facebook, LinkedIn, X and Instagram videos and images, powered by yt-dlp, ffmpeg and gallery-dl",
  "main": "src/main/main.js",
  "author": "Kamleshwar",
  "license": "MIT",
  "private": true,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "electron .",
    "test": "node --test",
    "icon": "python3 scripts/make-icon.py",
    "dist": "electron-builder --win nsis portable --x64 --publish never",
    "dist:dir": "electron-builder --win --dir --x64 --publish never"
  },
  "devDependencies": {
    "electron": "^44.9.0",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "com.kamleshwar.linkgrab",
    "productName": "LinkGrab",
    "copyright": "Copyright (c) Kamleshwar",
    "asar": true,
    "compression": "normal",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "src/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico",
      "artifactName": "LinkGrab-${version}-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "LinkGrab",
      "artifactName": "LinkGrab-Setup-${version}.${ext}"
    },
    "portable": {
      "artifactName": "LinkGrab-Portable-${version}.${ext}"
    },
    "publish": null
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Kamleshwarmaurya/linkgrab.git"
  },
  "homepage": "https://github.com/Kamleshwarmaurya/linkgrab#readme",
  "bugs": {
    "url": "https://github.com/Kamleshwarmaurya/linkgrab/issues"
  },
  "keywords": [
    "download-manager",
    "yt-dlp",
    "gallery-dl",
    "electron",
    "youtube",
    "instagram",
    "twitter",
    "x",
    "facebook",
    "linkedin"
  ]
}
